rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if caller is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if caller has ADMIN role
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "ADMIN";
    }

    // Users Collection
    match /users/{userId} {
      // Any authenticated user can read their own profile, Admins can read all
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // Only Admins can update/write users collection
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }
    
    // Tasks and Visits Collection
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}

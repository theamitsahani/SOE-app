rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if caller is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if caller has ADMIN role
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "ADMIN";
    }

    // Users Collection
    match /users/{userId} {
      // Any authenticated user can read their own profile, Admins can read all
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // Admins have full write permissions; employees can only update their own profile without altering role/status
      allow write: if isAdmin() || (
        isAuthenticated() && 
        request.auth.uid == userId && 
        (!exists(/databases/$(database)/documents/users/$(userId)) || (
          request.resource.data.role == resource.data.role &&
          request.resource.data.status == resource.data.status
        ))
      );
    }
    
    // Tasks and Visits Collection
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}

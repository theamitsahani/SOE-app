rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if caller is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Users Collection
    match /users/{userId} {
      // Authenticated users can read users (Admins sync list, officers load profile)
      allow read: if isAuthenticated();
      // Authenticated users can update/write users
      allow write: if isAuthenticated();
    }
    
    // Tasks, Visits, Schools and other Collections
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
